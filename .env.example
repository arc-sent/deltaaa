# Токен Telegram-бота (обязательно). Получить у @BotFather.
TELEGRAM_TOKEN=

# Telegram ID администраторов через запятую — кто видит ВСЕ ошибки в /errors.
# Свой ID можно узнать у @userinfobot. Пример: ADMIN_IDS=12345678,98765432
ADMIN_IDS=

# Как часто снимать число подписчиков всех групп (минуты). По умолчанию раз в час.
COLLECT_INTERVAL_MINUTES=60

# Ежедневный дайджест: во сколько присылать (МСК). Пусто = выключить рассылку.
DIGEST_HOUR=10
DIGEST_MINUTE=0

# Хранение логов ошибок: сколько суток хранить и как часто чистить.
ERROR_RETENTION_DAYS=5
ERROR_CLEANUP_INTERVAL_DAYS=5

# Ключ шифрования VK-токенов (необязательно). Если пусто — создаётся data/token.key.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=
